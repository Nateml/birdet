{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "birdet",
  "version": "0.1.0",
  "identifier": "com.nateml.birdet",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Birdet",
        "width": 1600,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/resources/recordings/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "nateml",
    "copyright": "© 2026 nateml",
    "category": "Education",
    "shortDescription": "Learn bird calls by ear.",
    "longDescription": "Birdet trains you to recognise birds by ear using spaced repetition, with recordings from Xeno-Canto and region data from eBird.",
    "resources": [
        "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
